  m_text: "\u30C8\u30E9\u30F3\u30D7\u3092\u4F7F\u3063\u305F\u30ED\u30FC\u30AB\u30EB\u5BFE\u6226(\u30DB\u30C3\u30C8\u30B7\u30FC\u30C8\u65B9\u5F0F\u30012\u301C4\u4EBA)\u30AB\u30FC\u30C9\u30B2\u30FC\u30E0\u3067\u3059\u3002\n\u30FB\u624B\u672D\u306F\u4EBA\u6570\u306B\u3088\u3089\u305A\u4E00\u4EBA6\u679A\u56FA\u5B9A\u3067\u3059\u3002\n\u30FB\u6BCE\u30BF\u30FC\u30F3\u3001\u30EB\u30FC\u30EC\u30C3\u30C8\u3067\u5224\u5B9A\u30AB\u30C6\u30B4\u30EA(\u6570\u5B57/\u30DE\u30FC\u30AF/\u8272)\u3092\u6C7A\u3081\u3001\u3081\u304F\u308A\u672D\u304B\u3089\u5F15\u3044\u305F\u57FA\u6E96\u30AB\u30FC\u30C9\u3068\u7D44\u307F\u5408\u308F\u305B\u307E\u3059\u3002\n\u30FB\u624B\u672D\u306E\u4E2D\u304B\u3089\u6761\u4EF6\u3092\u6E80\u305F\u3059\u30AB\u30FC\u30C9\u306F\u5168\u90E8\u6368\u3066\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002\u8A72\u5F53\u30AB\u30FC\u30C9\u304C\u306A\u3051\u308C\u3070\u30D1\u30B9\u3067\u3059\u3002\n\u30FB\u624B\u672D\u304C0\u679A\u306B\u306A\u3063\u305F\u4EBA\u304B\u3089\u9806\u306B\u9806\u4F4D\u304C\u78BA\u5B9A\u3057\u307E\u3059\u3002\u6700\u5F8C\u307E\u3067\u624B\u672D\u304C\u6B8B\u3063\u305F1\u4EBA\u306F\u81EA\u52D5\u7684\u306B\u6700\u4E0B\u4F4D\u3068\u306A\u308A\u3001\u30B2\u30FC\u30E0\u7D42\u4E86\u3067\u3059\u3002"
